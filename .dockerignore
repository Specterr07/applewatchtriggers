# Keep the build context small and clean. Without this, `COPY frontend/ .`
# in the Dockerfile would drag in a macOS-built node_modules on top of the
# fresh Linux `npm install` - which breaks native binaries (esbuild/rollup).
frontend/node_modules/
frontend/dist/
canvas_dist/

.venv/
__pycache__/
*.pyc

.git/
.github/
.DS_Store

# Runtime data - lives on the Fly volume, never in the image
tasks.csv
*.db
