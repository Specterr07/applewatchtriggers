# Data files - these live on the Fly.io volume, not in git
*.db

# Python
__pycache__/
*.pyc
.venv/
venv/

# macOS
.DS_Store

# Editor
.vscode/
.idea/

# Frontend (React app) - node_modules is huge and dist/ is
# generated fresh by the Docker build, neither belongs in git
frontend/node_modules/
frontend/dist/
*.tsbuildinfo

# Compiled React app the Docker build drops next to app.py (Stage 1 output).
# Only exists locally if you copy frontend/dist here to test /app.
web_dist/

# Env files (if you ever add a local .env)
.env

# Scratch files Claude saves locally (e.g. rendered diagram PNGs) - the
# diagram sources live in docs/features/, so these are disposable.
Claude outputs/
